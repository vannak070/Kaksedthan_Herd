# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy to .env.development or .env.production
# DO NOT COMMIT PRODUCTION CREDENTIALS OR SECRETS TO GIT
# ==============================================================================

# Application & Server Configuration
NODE_ENV=development
PORT=3000
API_PORT=5001
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=kaksedthan_herdbook
DB_SSL=false

# Database Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# File Storage Configuration (Separate for Dev vs Prod)
# Development: uploads/dev | Production: uploads/prod
UPLOAD_DIR=uploads/dev

# Security & Session Secrets
SESSION_SECRET=dev-secret-key-change-in-production
JWT_SECRET=dev-jwt-secret-change-in-production
