# ==============================================================================
# Production Environment Configuration Template (.env.production.example)
# To be supplied by server/deployment pipeline — DO NOT COMMIT REAL PRODUCTION SECRETS
# ==============================================================================

NODE_ENV=production
PORT=3000
API_PORT=3002
CORS_ORIGIN=https://livestock.kaksedthan.com
NEXT_PUBLIC_API_URL=/api/v1

# Production PostgreSQL Database (Port 5432)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_STRONG_PRODUCTION_PASSWORD
DB_NAME=livestock_db
DB_SSL=false

# Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# Storage (Production uploads)
UPLOAD_DIR=uploads/prod

# Production Secrets (Must be strong, unique strings)
SESSION_SECRET=GENERATE_STRONG_RANDOM_SESSION_SECRET_KEY
JWT_SECRET=GENERATE_STRONG_RANDOM_JWT_SECRET_KEY
