# ==============================================================================
# Development Environment Configuration (.env.development)
# Localhost Development Setup
# ==============================================================================

NODE_ENV=development
PORT=3000
API_PORT=5001
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1

# Local PostgreSQL Database (Port 5433)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=kaksedthan_herdbook
DB_SSL=false

# Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# Storage (Local uploads)
UPLOAD_DIR=uploads/dev

# Development Secrets
SESSION_SECRET=dev-session-secret-kaksedthan-local
JWT_SECRET=dev-jwt-secret-kaksedthan-local
